{
  "schemaVersion": 1,
  "id": "stitch",
  "version": "${version}",
  "name": "Stitch",
  "description": "Resource pack shaders (stitches) that keep working under shader packs.",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.ashleythew.stitch.fabric.StitchMod"]
  },
  "mixins": ["stitch-iris.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15",
    "minecraft": "${minecraft}"
  },
  "recommends": {
    "iris": "*"
  }
}
